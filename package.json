{
  "name": "scruple-plugin-ideology",
  "version": "0.3.0",
  "description": "Scruple plugin enforcing the engineering ideology in docs/ideologies as semantic lint rules.",
  "license": "MIT",
  "repository": "github:jaypeeZero/scruple-plugin-ideology",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "evals",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "ava",
    "lint": "eslint .",
    "eval": "node evals/run.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@scruple/core": ">=0.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@scruple/core": "latest",
    "@scruple/parser-oxc": "latest",
    "@scruple/provider-jev": "latest",
    "@types/node": "^24.13.4",
    "ava": "^6.4.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
